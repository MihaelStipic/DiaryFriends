@model DiaryEntry

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            
            <div class="card bg-dark text-white border-secondary shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="m-0">View Diary Entry</h2>
                </div>
                <div class="card-body">
                    
                    <div class="form-group mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control bg-dark text-white border-secondary" readonly />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Content" class="form-label">Content</label>
                        <textarea asp-for="Content" class="form-control bg-dark text-white border-secondary" readonly style="height: 300px !important; min-height: 300px;"></textarea>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Created" class="form-label">Created</label>
                        <input asp-for="Created" class="form-control bg-dark text-white border-secondary" type="date" readonly />
                    </div>

                    <div class="d-flex justify-content-start pt-2">
                      
                        <a asp-controller="DiaryEntries" asp-action="Show" class="btn btn-outline-light px-4">Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>