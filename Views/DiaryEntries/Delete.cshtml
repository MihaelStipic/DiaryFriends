@model DiaryEntry

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            <div class="card bg-dark text-white border-secondary shadow">
                <div class="card-header bg-danger text-white">
                    <h2 class="m-0">Delete Diary Entry</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label">Title</label>

                            <input asp-for="Title" class="form-control bg-dark text-white border-secondary" readonly />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Content" class="form-label">Content</label>

                            <textarea asp-for="Content" class="form-control bg-dark text-white border-secondary" rows="5" readonly></textarea>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Created" class="form-label">Created</label>
                            <input asp-for="Created" class="form-control bg-dark text-white border-secondary" type="date" readonly />
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <button type="submit" class="btn btn-danger px-4">Delete</button>
                            <a asp-controller="DiaryEntries" asp-action="Index"  class="btn btn-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}