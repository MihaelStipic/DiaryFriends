@model List<ApplicationUser>

@{
    var currentFriend = ViewBag.CurrentFriend as ApplicationUser;
}

<div class="container mt-4">
    @if (currentFriend != null)
    {
        
        <div class="card bg-dark text-white border-secondary mb-4">
            <div class="card-header border-secondary">
                <h5 class="mb-0">Your Friend</h5>
            </div>
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>@(currentFriend.FirstName ?? currentFriend.Email)</strong>
                    <div class="text-muted small">@currentFriend.Email</div>
                </div>
                <form asp-controller="Friends" asp-action="Remove" method="post" class="m-0">
                    <input type="hidden" name="friendId" value="@currentFriend.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure?');">
                        Remove
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- FORM ZA PRETRAGU -->
        <div class="col-12 col-md-7">
            <h2 class="text-white mb-3">
                Find your friend!
            </h2>
        </div>
        
        <form asp-controller="Friends" asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="text"
                       name="searchQuery"
                       value="@Context.Request.Query["searchQuery"]"
                       class="form-control bg-dark text-white border-secondary"
                       placeholder="Find new friend by their name or email" />

                <button type="submit" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                    Search
                </button>
            </div>
        </form>

        @if (Model != null && Model.Any())
        {
            <table class="table table-dark table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th style="width: 120px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                @(user.FirstName ?? user.Email)
                            </td>
                            <td>
                                <form asp-controller="Friends" asp-action="Add" method="post" class="m-0">
                                    <input type="hidden" name="friendId" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-success w-100">
                                        Add
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>