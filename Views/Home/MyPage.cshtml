@model DiaryFriends.Models.MyPageViewModel
@using DiaryFriends.Models

<div class="container" style="margin-top: 13rem;">
    <div class="row g-3 justify-content-center">

        <!-- My name-->
        <div class="col-12 col-md-5">
            <a class="btn btn-primary w-100 fs-3 d-flex align-items-center justify-content-center shadow-sm"
               style="height: 120px;"
               asp-controller="DiaryEntries"
               asp-action="Index">
                @Model.FirstName
            </a>
        </div>

        <!-- Your friend or add friend -->
        <div class="col-12 col-md-5">
            @if (Model.Friend != null)
            {
                <a class="btn btn-secondary w-100 fs-3 d-flex align-items-center justify-content-center shadow-sm"
                   style="height: 120px;"
                   asp-controller="DiaryEntries"
                   asp-action="Show"
                   asp-route-friend="@Model.Friend.Id"
                   asp-route-sortorder="asc">
                    @(Model.Friend.FirstName ?? Model.Friend.Email)
                </a>
            }
            else
            {
                <a class="btn btn-outline-secondary w-100 fs-3 d-flex align-items-center justify-content-center shadow-sm"
                   style="height: 120px;"
                   asp-controller="Friends"
                   asp-action="Index">
                    +
                </a>
            }
        </div>

    </div>
</div>

<style>
    .tic-tac-toe-board {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        grid-template-rows: repeat(3, 100px);
        justify-content: center;
        gap: 0;
        margin: 20px auto;
    }

    .grid-button {
        background-color: transparent;
        border: 4px solid #aaa;
        font-size: 3.5rem;
        font-weight: bold;
        color: #eee;
        cursor: pointer;
        outline: none;
        width: 100px;
        height: 100px;
    }

        .grid-button:nth-child(1), .grid-button:nth-child(2), .grid-button:nth-child(3) {
            border-top: none;
        }

        .grid-button:nth-child(1), .grid-button:nth-child(4), .grid-button:nth-child(7) {
            border-left: none;
        }

        .grid-button:nth-child(3), .grid-button:nth-child(6), .grid-button:nth-child(9) {
            border-right: none;
        }

        .grid-button:nth-child(7), .grid-button:nth-child(8), .grid-button:nth-child(9) {
            border-bottom: none;
        }
</style>

<!-- Check if its your turn, if it is -> refresh page -->
@if (Model.Game != null && (Model.Game.IsGameOver || Model.Game.CurrentTurnPlayerId != Model.CurrentUserId))
{
    <script>
                let checkInterval = setInterval(function () {
            fetch(`/Home/CheckTurn?gameId=@Model.Game.Id&isGameOver=@Model.Game.IsGameOver.ToString().ToLower()`)
                .then(response => response.json())
                .then(isMyTurn => {
                    if (isMyTurn === true) {
                        clearInterval(checkInterval);
                        window.location.reload();
                    }
                });
        }, 3000);
    </script>
}
<!--id="igra" so when the page refreshes it will not go on the top of the website-->
<div id="igra" class="card shadow-lg mx-auto mt-5 mb-5 text-light" style="max-width: 500px; border-radius: 15px; background-color: #1e1e1e; border: 1px solid #333;">
    <div class="card-header text-center py-3" style="border-radius: 15px 15px 0 0; background-color: #111; border-bottom: 1px solid #333;">
        <h3 class="mb-0 fw-bold">Tic-Tac-Toe</h3>
    </div>

    <div class="card-body p-4" style="border-radius: 0 0 15px 15px; background-color: #1e1e1e;">

        <form method="post" asp-action="PlayMove" asp-controller="Home" asp-fragment="igra" class="tic-tac-toe-board">
            @for (int i = 0; i < 9; i++)
            {
                string symbol = Model.Board[i] == "-" ? "" : Model.Board[i];
                bool isDisabled = Model.Board[i] != "-";

                <button type="submit" name="cellIndex" value="@i" class="grid-button" @(isDisabled ? "disabled" : "")>
                    @symbol
                </button>
            }
        </form>

        @if (Model.Game != null)
        {
            @if (!Model.Game.IsGameOver)
            {
                @if (Model.Game.CurrentTurnPlayerId == Model.CurrentUserId)
                {
                    <div class="text-center mt-4">
                        <h4 class="text-success fw-bold">
                            Your turn!
                            @if (Model.Game.Player1Id == Model.CurrentUserId)
                            {
                                <span class="text-success">(X)</span>
                            }
                            else
                            {
                                <span class="text-info">(O)</span>
                            }
                        </h4>
                    </div>
                }
                else
                {
                    <div class="text-center mt-4">
                        <h4 class="text-danger fw-bold">
                            Their turn!
                            @if (Model.Game.Player1Id == Model.CurrentUserId)
                            {
                                <span class="text-info">(O)</span>
                            }
                            else
                            {
                                <span class="text-success">(X)</span>
                            }
                        </h4>
                    </div>
                }
            }
            else
            {
                <div class="text-center mt-4">
                    @if (Model.Game.WinnerId == "Draw")
                    {
                        <h3 class="text-warning fw-bold">Draw!</h3>
                    }
                    else if (Model.Game.WinnerId == Model.CurrentUserId)
                    {
                        <h3 class="text-success fw-bold">You won!</h3>
                    }
                    else
                    {
                        <h3 class="text-danger fw-bold">You lost!</h3>
                    }

                    @if (Model.Game.CurrentTurnPlayerId == Model.CurrentUserId)
                    {
                        <a asp-action="Restart" asp-controller="Home" class="btn btn-primary btn-lg mt-3 px-5 shadow-sm">
                            Play again
                        </a>
                    }
                </div>
            }
        }
    </div>
</div>